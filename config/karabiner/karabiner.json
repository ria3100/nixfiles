{
    "profiles": [
        {
            "complex_modifications": {
                "parameters": { "basic.simultaneous_threshold_milliseconds": 0 },
                "rules": [
                    {
                        "description": "halfSpaceOnly",
                        "enabled": false,
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": {
                                        "mandatory": [],
                                        "optional": []
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "spacebar",
                                        "modifiers": ["left_shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "右Optionキー単押し: 指定アプリ（現在: cmux / bundle: com.cmuxterm.app）がフロントなら直前アプリへ戻る（Cmd+Tab）、それ以外は指定アプリを起動・アクティブ化",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.cmuxterm\\.app$"]
                                    }
                                ],
                                "from": {
                                    "key_code": "right_option",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                                "to": [
                                    {
                                        "key_code": "right_option",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    { "key_code": "tab", "modifiers": ["left_command"] }
                                ],
                                "to_if_held_down": [
                                    { "key_code": "right_option" }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "type": "frontmost_application_unless",
                                        "bundle_identifiers": ["^com\\.cmuxterm\\.app$"]
                                    }
                                ],
                                "from": {
                                    "key_code": "right_option",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                                "to": [
                                    {
                                        "key_code": "right_option",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [
                                    { "shell_command": "/usr/bin/open -a 'cmux'" }
                                ],
                                "to_if_held_down": [
                                    { "key_code": "right_option" }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "コマンドキーを単体で押したときに、英数・かなキーを送信する。（左コマンドキーは英数、右コマンドキーはかな） (rev 3)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                                "to": [
                                    {
                                        "key_code": "left_command",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "japanese_eisuu" }],
                                "to_if_held_down": [{ "key_code": "left_command" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 100 },
                                "to": [
                                    {
                                        "key_code": "right_command",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "japanese_kana" }],
                                "to_if_held_down": [{ "key_code": "right_command" }],
                                "type": "basic"
                            }
                        ]
                    }
